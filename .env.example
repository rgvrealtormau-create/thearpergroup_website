# FRED API key for the live mortgage-rate feed (Freddie Mac PMMS via api.stlouisfed.org).
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Optional — without it, the mortgage calculator falls back to a flat 6.5% rate.
FRED_API_KEY=

# --- Lead pipeline: app/api/lead/route.js (sphere sheet + Brivity email) ---

# Resend (https://resend.com) — sends the lead to Brivity's parsing address.
RESEND_API_KEY=
# Must be "Name <user@domain>" on a domain verified in Resend.
LEAD_FROM_EMAIL="The Arper Group Website <leads@thearpergroup.com>"
# Optional override; defaults to Mauricio's Brivity parsing address (Agent User ID 510286).
BRIVITY_LEAD_EMAIL=j_mauricio_arredondo@mail.brivity.com

# Google service account with edit access on the sphere nurture sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON, \n escapes are fine.
GOOGLE_PRIVATE_KEY=
# "Sphere Nurture Database — Mauricio Arredondo"
GOOGLE_SHEET_ID=1SMaE8sdSkaUjkSFWuMZiaBSBby0eAZcGDh-PjgJFWi4
# Tab name + column range — confirm the tab name, sheet's header row is 16 cols (A:P).
GOOGLE_SHEET_RANGE=Sheet1!A:P
